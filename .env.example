# Copie ce fichier en .env et renseigne tes valeurs.
# Les donnees de marche spot MEXC (liste des paires, prix) sont PUBLIQUES :
# la cle n'est pas obligatoire pour ce script. Elle est juste utilisee si un
# jour on ajoute des endpoints prives (solde, ordres...).
MEXC_API_KEY=
MEXC_API_SECRET=

# URL de base de l'API (change-la si tu utilises un domaine miroir)
MEXC_BASE_URL=https://api.mexc.com

# Intervalle entre deux verifications de la liste des paires (secondes)
CHECK_INTERVAL_SECONDS=60

# Duree de suivi du prix d'un nouveau listing (secondes)
TRACK_DURATION_SECONDS=300

# Intervalle d'echantillonnage du prix pendant le suivi (secondes, 5 a 10 conseille)
TRACK_SAMPLE_INTERVAL_SECONDS=7

# Filtre optionnel sur la devise de cotation. Vide = toutes les paires.
# Mets USDT pour ne suivre que les nouveaux listings *USDT.
QUOTE_FILTER=USDT
