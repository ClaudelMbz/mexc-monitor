# Copie ce fichier en .env et renseigne tes valeurs.
# Les donnees de marche spot MEXC (liste des paires, prix) sont PUBLIQUES :
# la cle n'est pas obligatoire pour ce script. Elle est juste utilisee si un
# jour on ajoute des endpoints prives (solde, ordres...).
MEXC_API_KEY=
MEXC_API_SECRET=

# URL de base de l'API (change-la si tu utilises un domaine miroir)
MEXC_BASE_URL=https://api.mexc.com

# Intervalle entre deux verifications de la liste des paires (secondes).
# 60 = detection ~30s en moyenne. Baisser a 15 ou 10 pour detecter plus vite.
CHECK_INTERVAL_SECONDS=60

# --- Suivi d'un nouveau listing -------------------------------------------
# Phase 1 : la paire est visible mais ne trade pas encore (pas de prix).
# On interroge le prix a cette cadence jusqu'au premier prix reel.
PRICE_WAIT_POLL_SECONDS=3
# Abandon du suivi si aucun prix apres ce delai (secondes). 7200 = 2 h.
PRICE_WAIT_TIMEOUT_SECONDS=7200

# Phase 2 : fenetre de mesure, comptee A PARTIR DU PREMIER PRIX REEL.
TRACK_DURATION_SECONDS=180
# Intervalle d'echantillonnage pendant la mesure (2 s conseille pour capter
# les mouvements rapides du premier pump).
TRACK_SAMPLE_INTERVAL_SECONDS=2

# Filtre optionnel sur la devise de cotation. Vide = toutes les paires.
# Mets USDT pour ne suivre que les nouveaux listings *USDT.
QUOTE_FILTER=USDT
