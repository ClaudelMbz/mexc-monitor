# Copie ce fichier en .env et renseigne tes valeurs.
# Les donnees de marche spot MEXC (liste des paires, prix, bougies) sont
# PUBLIQUES : la cle n'est pas obligatoire pour ce script.
MEXC_API_KEY=
MEXC_API_SECRET=

# URL de base de l'API (change-la si tu utilises un domaine miroir)
MEXC_BASE_URL=https://api.mexc.com

# Intervalle entre deux scans de la liste des paires (secondes).
# 60 = detection ~30s en moyenne. Baisser a 15 ou 10 pour detecter plus vite.
CHECK_INTERVAL_SECONDS=60

# --- Phase 1 : attente du premier prix (paire visible mais ne trade pas) ---
PRICE_WAIT_POLL_SECONDS=3
PRICE_WAIT_TIMEOUT_SECONDS=7200

# --- Phase 2 : capture tick (microstructure), comptee a partir du 1er prix ---
TRACK_DURATION_SECONDS=180
TRACK_SAMPLE_INTERVAL_SECONDS=2

# --- Phase 3 : suivi des bougies 1m (spike -> repli -> stabilisation) ---
# Le pic arrive souvent plusieurs heures apres le listing.
KLINE_FOLLOW_MINUTES=120
KLINE_POLL_SECONDS=30

# Filtre optionnel sur la devise de cotation. Vide = toutes les paires.
QUOTE_FILTER=USDT
